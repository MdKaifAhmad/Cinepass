{
  "name": "cinepass",
  "version": "1.0.0",
  "description": "A scalable movie ticket booking system with Docker, Redis seat-locking, and Stripe payments",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "express": "^5.1.0",
    "@prisma/client": "^6.6.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2",
    "zod": "^3.25.3",
    "stripe": "^18.1.0",
    "socket.io": "^4.8.1",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "winston": "^3.17.0",
    "dotenv": "^16.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
